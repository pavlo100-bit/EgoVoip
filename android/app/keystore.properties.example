# Real release-signing config — copy this file to `keystore.properties` (same
# folder, gitignored, never committed) and fill in the real values.
#
# Generate the keystore yourself first (do this once, keep the resulting
# .keystore file and these passwords somewhere safe — losing them means you
# can never publish an update under the same app identity again):
#
#   cd android/app
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore egovoip-release.keystore \
#     -alias egovoip -keyalg RSA -keysize 2048 -validity 10000
#
# keytool will prompt you to choose a store password and a key password —
# pick your own, do not reuse the debug keystore's password, and do not
# paste them into chat/logs/commits.
#
# Then fill in the same values below:
RELEASE_STORE_FILE=egovoip-release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=egovoip
RELEASE_KEY_PASSWORD=changeme
