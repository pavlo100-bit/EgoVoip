# Settings -> API in your Zadarma dashboard. Read access to PBX/WebRTC is enough.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_SIP_LOGIN=

# Settings -> SIP Connection. Not a secret itself (it's a routable extension
# number), but kept here so it never has to be typed into a chat session or
# passed as a shell argument that ends up in scrollback/history.

PORT=4000
